# Cloudinary credentials
# Dashboard thekaa copy koro: https://console.cloudinary.com/console
# Settings > Access Keys section e sob paabe.
#
# Ei file ta template. Copy kore .env.local banaw ar actual values boshaw.
# .env.local is gitignored, so secrets never commit hobe.

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public-facing cloud name (same as above, exposed to the browser via Next.js)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
